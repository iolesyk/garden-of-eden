[Unit]
Description=Gardyn Hydroponic System
After=network.target
Wants=network.target

[Service]
Type=simple
User=oles
Group=oles
WorkingDirectory=/home/oles/garden-of-eden
Environment=PATH=/home/oles/garden-of-eden/venv/bin:/opt/vc/bin:/usr/bin:/bin
ExecStart=/home/oles/garden-of-eden/venv/bin/python3 /home/oles/garden-of-eden/mqtt.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Load environment variables from .env file
EnvironmentFile=/home/oles/garden-of-eden/.env

[Install]
WantedBy=multi-user.target
