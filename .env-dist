# device infor for homeassistant
MQTT_IDENTIFIER=gardyn_03
MQTT_BASETOPIC=gardyn
MQTT_DEVICE_MODEL="gardyn 3.0"
MQTT_VERSION="1.0.0"

# MQTT broker config
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=gardyn
MQTT_PASSWORD=somepassword
MQTT_KEEPALIVE_INTERVAL=60

WATER_LOW_CM=17

# Auto Pump Configuration
# Enable/disable auto pump on startup (true/false)
AUTO_PUMP_ENABLED=true
# Day schedule (in minutes)
AUTO_PUMP_DAY_ON_TIME=15
AUTO_PUMP_DAY_OFF_TIME=15
# Night schedule (in minutes)
AUTO_PUMP_NIGHT_ON_TIME=15
AUTO_PUMP_NIGHT_OFF_TIME=30
# Day/Night time boundaries (24-hour format)
AUTO_PUMP_DAY_START_HOUR=6
AUTO_PUMP_DAY_END_HOUR=18

# Temperature-based pump control (day only)
TEMP_PUMP_ENABLED=true
TEMP_PUMP_THRESHOLD_1=27.0
TEMP_PUMP_ON_TIME_1=10
TEMP_PUMP_OFF_TIME_1=10
TEMP_PUMP_THRESHOLD_2=29.0
TEMP_PUMP_ON_TIME_2=5
TEMP_PUMP_OFF_TIME_2=5

UPPER_CAMERA_DEVICE=/dev/video0
LOWER_CAMERA_DEVICE=/dev/video2
UPPER_IMAGE_PATH=/tmp/upper_camera.jpg
LOWER_IMAGE_PATH=/tmp/lower_camera.jpg
CAMERA_RESOLUTION="640x480"
IMAGE_INTERVAL_SECONDS=3600
